# Cool Beans self-host configuration. Copy to .env and fill in.
# In k8s these come from the deployment env/secrets instead.

# --- Core (REQUIRED) ---
# PostgreSQL connection URL. Compose provides the server; this is the in-network address.
DATABASE_URL=postgres://coolbeans:change-me@postgres:5432/coolbeans
# Bearer token for admin endpoints and the beans CLI. Generate: openssl rand -hex 32
# Required for self-host. The hosted deployment leaves this unset on purpose: it is a
# global bypass with no account behind it, which has no place in a multi-tenant instance.
ADMIN_TOKEN=
# Encrypts offline-token signing private keys at rest. Generate: openssl rand -hex 32
SIGNING_KEY_SECRET=

# --- Server ---
PORT=3000

# --- Stripe (optional until payments are wired) ---
# Restricted key: Checkout Sessions read, Subscriptions read.
STRIPE_SECRET_KEY=
# Local journey tests only: point the Stripe SDK at a mock instead of api.stripe.com.
# Leave unset everywhere else.
# STRIPE_API_BASE=http://localhost:12111
STRIPE_WEBHOOK_SECRET=

# Days added to a licence's expiry when it goes into a signed offline token. The SDK ends
# access when a signed expires_at has passed, so the raw expiry would lock out a subscriber
# who renewed while offline and still holds a stale token. This is the room they get to
# reconnect. Never applied to trials. Default 14.
# OFFLINE_TOKEN_BUFFER_DAYS=14

# TTL for a vendor-issued offline activation, in days. Long because an air-gapped machine
# can never refresh — it gets one token and lives on it. Always clamped to the licence's
# own expiry. Note such a machine cannot be revoked before this elapses. Default 365.
# OFFLINE_ACTIVATION_TTL_DAYS=365

# --- Platform billing (hosted Cool Beans only; leave blank for self-host) ---
# This is Goldenberry charging customers for hosted Cool Beans, NOT a customer selling
# their own software. That is STRIPE_SECRET_KEY above, and the two must be different
# Stripe accounts: sharing one puts both flows on a single event stream where a Pro
# purchase can be mistaken for a product sale. The server refuses to start if they match
# in production.
#
# Setting BILLING_STRIPE_SECRET_KEY is what puts the instance in cloud mode: plan limits
# apply (Free is 1 product and 500 active licences) and public signup opens. Leave it
# blank and everything is unlimited, which is what self-host is.
BILLING_STRIPE_SECRET_KEY=
# Required whenever the key above is set, or every upgrade attempt fails.
BILLING_STRIPE_PRO_PRICE_ID=
# Required in production: without it Stripe charges the card and we never record it.
BILLING_STRIPE_WEBHOOK_SECRET=
# Local journey tests only, same as STRIPE_API_BASE.
# BILLING_STRIPE_API_BASE=http://localhost:12111

# --- Stripe Connect (cloud multi-vendor only; leave blank for self-host) ---
# The platform Connect credential. On the hosted deployment each vendor authorizes their
# own Stripe account through Connect, and all their events arrive on ONE platform endpoint
# (/v1/connect/stripe/webhook) keyed by the signed event.account. Separate account and
# namespace from STRIPE_* (self-host, one account) and BILLING_STRIPE_* (us charging
# customers), so the three can never be confused. Self-host leaves all of these blank and
# uses STRIPE_* with its single default connection instead.
CONNECT_STRIPE_SECRET_KEY=
# The Connect OAuth client id (ca_...). Required for vendor self-serve onboarding: the
# console sends them to Stripe with this, and Stripe returns them to
# PUBLIC_URL/v1/connect/stripe/callback, which must be listed as a redirect URI on the
# Connect application.
CONNECT_STRIPE_CLIENT_ID=
# Required in production whenever CONNECT_STRIPE_SECRET_KEY is set: without it connected
# events arrive and none can be verified, so no cloud vendor is ever paid.
CONNECT_STRIPE_WEBHOOK_SECRET=
# Local journey tests only, same as STRIPE_API_BASE.
# CONNECT_STRIPE_API_BASE=http://localhost:12111

# --- PayPal (optional) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Email (REQUIRED in production; pick one) ---
# EMAIL_PROVIDER=resend | smtp | console (console is local development only)
EMAIL_PROVIDER=
# Local development: log emails instead of delivering them, so you need no mail provider
# at all. Refused when NODE_ENV=production.
# EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Local development only: print console sign-in codes to the log instead of hunting for
# the email. A code is a credential, so the server refuses to start with this enabled
# when NODE_ENV=production.
# LOG_MAGIC_CODES=true
