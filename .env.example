# Cool Beans self-host configuration. Copy to .env and fill in.
# In k8s these come from the deployment env/secrets instead.

# --- Core (REQUIRED) ---
# SQLite file path, or a Postgres URL later.
DATABASE_URL=./data/coolbeans.sqlite
# Bearer token for admin endpoints and the beans CLI. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Encrypts offline-token signing private keys at rest. Generate: openssl rand -hex 32
SIGNING_KEY_SECRET=

# --- Server ---
PORT=3000

# --- Stripe (optional until payments are wired) ---
# Restricted key: Checkout Sessions read, Subscriptions read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (optional) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Email (optional; pick one) ---
# EMAIL_PROVIDER=resend | smtp
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
