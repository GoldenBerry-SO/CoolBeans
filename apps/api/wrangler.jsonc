// ABOUTME: Cloudflare Workers deployment config for the Cool Beans cloud instance.
// ABOUTME: The D1 binding and secrets are wired when the storage adapter lands.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coolbeans-api",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-01",
	"vars": {
		"ENVIRONMENT": "production"
	}
	// [[d1_databases]] binding is added by the storage-adapter issue:
	// "d1_databases": [{ "binding": "DB", "database_name": "coolbeans", "database_id": "…" }]
}
