{
	"name": "@coolbeans/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#hooks/*": "./src/hooks/*.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
