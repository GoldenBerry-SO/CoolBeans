---
// ABOUTME: The six feature cards on the paper band: issuance, seats, metering, payments,
// ABOUTME: edge validation, and self-host. Copy corrected where the design predated the product.

const features = [
	{
		title: 'Issue keys instantly',
		body: 'Signed keys the moment someone pays. Per-product prefixes, tiers, and expiry baked in, no cron jobs.',
		icon: 'key',
	},
	{
		title: 'Seats & activations',
		body: 'Node-locked or floating leases. Customers free a seat themselves. The support ticket never gets filed.',
		icon: 'seats',
	},
	{
		title: 'Metered usage',
		body: "Atomic counters in single guarded statements. Set a cap and you'll never get oversold, even under a thundering herd.",
		icon: 'meter',
	},
	{
		title: 'Payments, wired',
		body: 'Checkout, refund, cancel. Stripe and PayPal webhooks issue and revoke keys automatically, signatures verified.',
		icon: 'wire',
	},
	{
		title: 'Works offline',
		body: 'Signed ed25519 tokens verify locally, so your app opens with no network at all. Rotate signing keys without downtime.',
		icon: 'shield',
	},
	{
		title: 'Self-host or cloud',
		body: 'Run one docker compose up against your Postgres, or let us operate it. The core is open source, so your keys and data stay yours.',
		icon: 'racks',
	},
];
---

<section id="features" class="border-ink/7 border-y bg-paper">
	<div class="mx-auto max-w-[1180px] px-6 py-22 lg:px-10">
		<div class="mb-13 max-w-[640px]">
			<div class="mb-3 font-semibold text-[14px] text-moss">Everything in one place</div>
			<h2
				class="m-0 font-semibold text-[clamp(32px,4vw,44px)] leading-[1.08] tracking-[-0.025em]"
			>
				From "they paid" to "it's unlocked"
			</h2>
			<p class="mt-4 mb-0 text-[17px] text-smoke leading-[1.55]">
				Issuance, seats, metering, refunds. The whole path from a Stripe payment to a working
				app, without the glue code.
			</p>
		</div>
		<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
			{
				features.map((f) => (
					<div class="rounded-[14px] border border-ink/9 bg-white p-6">
						<span class="mb-4 inline-flex size-11 items-center justify-center rounded-[11px] border border-chip-line bg-chip">
							<svg
								width="22"
								height="22"
								viewBox="0 0 24 24"
								fill="none"
								stroke="#3f6b12"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								{f.icon === 'key' && (
									<>
										<circle cx="7.5" cy="8" r="4" />
										<path d="M10.5 11 L20 20.5 M17 17.5 L19.5 15" />
									</>
								)}
								{f.icon === 'seats' && (
									<>
										<rect x="3" y="4" width="18" height="12" rx="2" />
										<path d="M8 20h8M12 16v4" />
									</>
								)}
								{f.icon === 'meter' && <path d="M5 19V11 M12 19V5 M19 19V14" />}
								{f.icon === 'wire' && (
									<>
										<circle cx="6" cy="6" r="2.6" />
										<circle cx="18" cy="18" r="2.6" />
										<path d="M8 7.5C13 9 15.5 12 16.5 16" />
									</>
								)}
								{f.icon === 'shield' && (
									<>
										<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" />
										<path d="M9 12l2 2 4-4" />
									</>
								)}
								{f.icon === 'racks' && (
									<>
										<rect x="3" y="4" width="18" height="7" rx="2" />
										<rect x="3" y="13" width="18" height="7" rx="2" />
										<path d="M7 7.5h.01M7 16.5h.01" />
									</>
								)}
							</svg>
						</span>
						<h3 class="mt-0 mb-[7px] font-semibold text-[17px]">{f.title}</h3>
						<p class="m-0 text-[14.5px] text-smoke leading-normal">{f.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
