---
// ABOUTME: The dark stats band — four facts on coal with lime figures.
// ABOUTME: Every figure is verifiable in the repo; no invented uptime or latency claims.

const stats = [
	{ figure: 'MIT', unit: '', label: 'licensed — read every line, run it anywhere' },
	{ figure: '$0', unit: '', label: 'per-licence fees, at any scale' },
	{ figure: '2', unit: 'SDKs', label: 'TypeScript and Swift, one shared decision contract' },
	{ figure: '1', unit: 'cmd', label: 'to self-host: docker compose up' },
];
---

<section class="bg-coal text-bone">
	<div class="mx-auto max-w-[1180px] px-6 py-20 lg:px-10">
		<div class="mb-12 max-w-[560px]">
			<h2 class="m-0 font-semibold text-[clamp(30px,3.6vw,40px)] leading-[1.1] tracking-tight">
				Built to be relied on
			</h2>
			<p class="mt-3.5 mb-0 text-[#a8a89f] text-[17px] leading-[1.55]">
				Signed offline tokens keep paying customers unlocked even with no network at all — an
				unknown answer never locks anyone out. Only an explicit revocation does.
			</p>
		</div>
		<div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
			{
				stats.map((s) => (
					<div class="border-bone/16 border-t pt-5">
						<div class="font-semibold text-[clamp(34px,4vw,46px)] text-lime leading-none tracking-tight">
							{s.figure}
							{s.unit && <span class="font-medium text-[0.5em]">{s.unit}</span>}
						</div>
						<div class="mt-2 text-[#a8a89f] text-[14px]">{s.label}</div>
					</div>
				))
			}
		</div>
	</div>
</section>
