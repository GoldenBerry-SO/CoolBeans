---
// ABOUTME: The "who is it for" band: four audiences with the one claim each cares about.
// ABOUTME: Every claim maps to a shipped feature; no audience we can't actually serve yet.

// Icons are stroke paths in the same chip idiom as the feature cards.
const audiences = [
	{
		icon: 'M4 5.5h16v10.5H4z M2 19h20',
		title: 'Indie developers',
		body: 'Selling a desktop app, a CLI, or an Electron/Tauri build? Keys, activation limits, and trials are one open() call, so you ship the product, not the licensing.',
	},
	{
		icon: 'M8.5 3h7a2 2 0 012 2v14a2 2 0 01-2 2h-7a2 2 0 01-2-2V5a2 2 0 012-2z M11 18h2',
		title: 'Mac & iOS apps',
		body: 'The Swift SDK speaks the same contract: Keychain storage, CryptoKit signatures, and offline tokens for laptops that leave the network.',
	},
	{
		icon: 'M9 10.5a3 3 0 100-6 3 3 0 000 6z M3.5 19c.7-3 2.7-4.5 5.5-4.5s4.8 1.5 5.5 4.5 M16.5 11a2.4 2.4 0 100-4.8 M16 14.7c2.3.2 4 1.6 4.7 4.3',
		title: 'Teams & floating seats',
		body: 'Concurrent seats with heartbeat leases. A crashed client frees its own seat, and customers release a lost machine themselves in the portal.',
	},
	{
		icon: 'M13 3L5 14h6l-1 7 8-11h-6l1-7z',
		title: 'Metered products',
		body: 'Selling by usage? Atomic per-licence quotas enforced at the edge, so a cap is a cap even under a thundering herd of retries.',
	},
];
---

<section id="who" class="mx-auto max-w-[1180px] px-6 py-22 lg:px-10">
	<div class="mb-13 max-w-[640px]">
		<div class="mb-3 font-semibold text-[14px] text-moss">Who it's for</div>
		<h2 class="m-0 font-semibold text-[clamp(32px,4vw,44px)] leading-[1.08] tracking-[-0.025em]">
			Built for people who'd rather be shipping
		</h2>
		<p class="mt-4 mb-0 text-[17px] text-smoke leading-[1.55]">
			You've built something worth paying for. Deciding who can use it shouldn't take months of
			webhook plumbing, or a per-seat bill from a licensing platform.
		</p>
	</div>
	<div class="grid gap-5 md:grid-cols-2">
		{
			audiences.map((a) => (
				<div class="flex gap-4 rounded-[14px] border border-ink/9 bg-white p-6">
					<span class="inline-flex size-11 flex-none items-center justify-center rounded-[11px] border border-chip-line bg-chip">
						<svg
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="#3f6b12"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							{a.icon.split(' M').map((d, i) => (
								<path d={i === 0 ? d : `M${d}`} />
							))}
						</svg>
					</span>
					<div>
						<div class="mb-1.5 font-semibold text-[16px] text-ink">{a.title}</div>
						<p class="m-0 text-[14.5px] text-smoke leading-[1.55]">{a.body}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
