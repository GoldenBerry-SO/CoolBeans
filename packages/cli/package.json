{
	"name": "@coolbeans/cli",
	"version": "0.1.0",
	"type": "module",
	"description": "beans \u2014 the Cool Beans admin CLI.",
	"license": "MIT",
	"author": "GoldenBerry",
	"homepage": "https://coolbeans.tools",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GoldenBerry-SO/coolbeans.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/GoldenBerry-SO/coolbeans/issues"
	},
	"keywords": [
		"license",
		"licensing",
		"license-key",
		"cli",
		"admin",
		"stripe",
		"coolbeans"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"beans": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsup src/index.ts --format esm",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "~7.0.2",
		"vitest": "^4.1.10"
	}
}
