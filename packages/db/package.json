{
	"name": "@coolbeans/db",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"drizzle"
	],
	"scripts": {
		"dev": "tsup src/index.ts --format esm --watch --no-dts",
		"build": "tsup src/index.ts src/migrate-cli.ts --format esm && tsc -p tsconfig.build.json",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node dist/migrate-cli.js"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.8"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@types/node": "^24.0.0",
		"drizzle-kit": "^0.31.10",
		"tsup": "^8.5.1",
		"typescript": "~7.0.2",
		"vitest": "^4.1.10"
	}
}
