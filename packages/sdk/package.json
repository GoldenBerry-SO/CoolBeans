{
	"name": "@coolbeans/sdk",
	"version": "0.1.0",
	"type": "module",
	"description": "Drop-in licensing for Node, Electron, Tauri, and the browser. The key is the credential.",
	"license": "MIT",
	"author": "GoldenBerry",
	"homepage": "https://coolbeans.tools",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GoldenBerry-SO/coolbeans.git",
		"directory": "packages/sdk"
	},
	"bugs": {
		"url": "https://github.com/GoldenBerry-SO/coolbeans/issues"
	},
	"keywords": [
		"license",
		"licensing",
		"license-key",
		"licence",
		"activation",
		"offline",
		"ed25519",
		"electron",
		"tauri",
		"stripe",
		"sdk"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsup src/index.ts --format esm --watch --no-dts",
		"build": "tsup src/index.ts --format esm && tsc -p tsconfig.build.json",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsup": "^8.5.1",
		"typescript": "~7.0.2",
		"vitest": "^4.1.10"
	}
}
