{
	"name": "@coolbeans/sdk",
	"version": "0.0.0",
	"type": "module",
	"description": "Drop-in licensing for Node, Electron, Tauri, and the browser. The key is the credential.",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsup src/index.ts --format esm --watch --no-dts",
		"build": "tsup src/index.ts --format esm && tsc -p tsconfig.build.json",
		"lint": "biome check src/",
		"format": "biome format --write src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "~7.0.2",
		"vitest": "^4.1.10"
	}
}
